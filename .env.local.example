# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Market Analyzer (optional; Yahoo Finance works without keys)
# Finnhub — used for supplemental quotes + webhook verification.
FINNHUB_API_KEY=
FINNHUB_WEBHOOK_SECRET=

# Anthropic API (enables AI narrative on the Analyzer detail page)
# Get a key at https://console.anthropic.com — uses Claude Haiku 4.5 (~$0.005/run)
ANTHROPIC_API_KEY=

# TradingAgents sidecar (optional; heavy multi-agent alternative to AI narrative)
# Deploy tradingagents/ separately (see tradingagents/README.md), then point here.
TRADINGAGENTS_URL=
TRADINGAGENTS_API_SECRET=
