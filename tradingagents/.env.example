# Required: at least one LLM provider key. TradingAgents uses OpenAI by default.
OPENAI_API_KEY=

# Required: market data (Alpha Vantage free tier works).
ALPHA_VANTAGE_API_KEY=

# Optional alternate providers.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# Sidecar-only.
# If set, /analyze requires header X-API-Key: <this value>. Use a long random string.
TRADINGAGENTS_API_SECRET=
# Restrict CORS to your Next.js origin in production, e.g. https://trading-journal-eta-topaz.vercel.app
TRADINGAGENTS_ALLOWED_ORIGIN=*
